REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id

# Optional: only this Firebase login may read question reports (dev UI + Firestore reads).
# Must match questionReportsViewerEmail() in firestore.rules when you use a non-default email.
# REACT_APP_QUESTION_REPORTS_VIEWER_EMAIL=tutor@example.com

# Set to 1 so instructors see /font-lab and the “Fonts” nav in production (optional).
# In development, Font Lab is available to instructors only.
REACT_APP_FONT_LAB=0
